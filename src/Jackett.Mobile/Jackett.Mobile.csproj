<Project Sdk="Microsoft.NET.Sdk">

  <!-- iOS app. Needs a Mac with Xcode and the MAUI workload: see README.md -->

  <PropertyGroup>
    <TargetFramework>net10.0-ios</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>Jackett.Mobile</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>

    <ApplicationTitle>Jackett</ApplicationTitle>
    <!-- Change to your own identifier before signing -->
    <ApplicationId>org.jackett.mobile</ApplicationId>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <SupportedOSPlatformVersion>15.0</SupportedOSPlatformVersion>

    <!-- Jackett creates indexers, YAML and JSON models through reflection: keep our assemblies whole
         and allow dynamic code (the interpreter) on top of the AOT compiled app. -->
    <MtouchLink>SdkOnly</MtouchLink>
    <UseInterpreter>true</UseInterpreter>

    <!-- HttpClientHandler stays the managed handler; the native NSUrlSessionHandler is created explicitly
         (see Platforms/iOS/IosPlatformServices.cs) so it can be switched off in the settings. -->
    <UseNativeHttpHandler>false</UseNativeHttpHandler>
  </PropertyGroup>

  <ItemGroup>
    <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#1E293B" />
    <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#1E293B" BaseSize="128,128" />
    <MauiImage Include="Resources\Images\*.svg" />

    <!-- The tracker definitions, read from the app bundle at runtime -->
    <MauiAsset Include="..\Jackett.Common\Definitions\*.yml" LogicalName="JackettDefinitions\%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Jackett.Mobile.Core\Jackett.Mobile.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <TrimmerRootAssembly Include="Jackett.Common" />
    <TrimmerRootAssembly Include="Jackett.Mobile.Core" />
    <TrimmerRootAssembly Include="Jackett.Mobile" />
  </ItemGroup>

</Project>
